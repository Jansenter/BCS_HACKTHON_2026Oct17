{
  "name": "artwalk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ArtWalk — your personal city art storyteller. Hackathon MVP for Downtown Vancouver.",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test:nearby": "node --test server/nearby.test.mjs",
    "test:profile": "node scripts/test-profile.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.4"
  }
}
