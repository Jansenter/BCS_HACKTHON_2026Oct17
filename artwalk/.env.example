# Optional: real walking routes between stops (https://openrouteservice.org — free key).
# Without it, ArtWalk draws a straight dashed path and links each leg to OpenStreetMap directions.
VITE_ORS_API_KEY=

# Server-only AI ranking. Never prefix these with VITE_.
# Without a key, real nearby OpenStreetMap places are still shown by distance.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional production server port (npm start after npm run build).
PORT=4173
# Optional alternative/self-hosted Overpass endpoint (server only).
# OVERPASS_URL=https://your-overpass-provider/api/interpreter
