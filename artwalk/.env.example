# Optional: real walking routes between stops (https://openrouteservice.org — free key).
# Without it, ArtWalk draws a straight dashed path and links each leg to OpenStreetMap directions.
VITE_ORS_API_KEY=

# Required for CARTO Voyager map tiles (request a free key at https://carto.com/basemaps/apikey/).
VITE_CARTO_API_KEY=
